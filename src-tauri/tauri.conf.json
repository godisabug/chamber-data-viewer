{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "实验箱数据查看器",
  "mainBinaryName": "实验箱数据查看器",
  "version": "0.1.0",
  "identifier": "io.github.godisabug.chamberdataviewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "实验箱数据查看器",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 680,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "maximized": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
