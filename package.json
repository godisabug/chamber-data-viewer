  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "prototype": "vite prototype --host 127.0.0.1 --port 1421",
    "build": "tsc -b && vite build",
    "build:portable": "tauri build --no-bundle",
    "build:installer": "tauri build --bundles nsis",
